# --- Python ---
__pycache__/
*.py[cod]
*.so

# --- Virtualenv ---
venv/
.venv/
.env

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
*.code-workspace

# --- Runtime output ---
logs/

# --- Local git hooks (developer convenience; not published) ---
scripts/git-hooks/dev-tools/
.dev-tools-version
repo_owners.yaml

# --- Seeded SQLite database ---
# The generated database is deliberately NOT committed. `scripts/quick-start.sh`
# creates and seeds it when it is absent, so a clone proves the pipeline actually
# runs (init_db → seed_from_json) rather than trusting a committed binary, and
# diffs stay readable. `sample_data.json` — the real source of truth — IS
# committed. Matched at any depth: the artifact lives at
# pricing-scraper/data/market_data.db.
**/data/*.db
**/data/*.sqlite
