# Modelled on algo-trader/.gitignore + ai-platform/.gitignore.

# --- Python ---
__pycache__/
*.py[cod]
*.so

# --- Virtualenv ---
venv/
.venv/
.env

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
*.code-workspace

# --- Runtime output ---
logs/

# --- dev-tools (also appended by dev-tools/install.sh; declared here so a fresh
#     clone that has not run install.sh still ignores them) ---
scripts/git-hooks/dev-tools/
.dev-tools-version
repo_owners.yaml

# --- Seeded SQLite database ---
# DECISION 1: the seeded `.db` is NOT committed. `scripts/quick-start.sh` seeds it
# when absent, so a clone proves the scrapers/pipeline actually run (init_db →
# seed_from_json) rather than trusting a committed binary, and diffs stay readable.
# Matched at any depth: the artifact lives at pricing-scraper/data/market_data.db.
# NOTE: the plan's step A2 wording ("do NOT ignore `data/*.db`") contradicts
# Decision 1; Decision 1 is the numbered, rationale-backed decision, so this file
# ignores the artifact and `sample_data.json` — the real source of truth — is
# committed instead.
**/data/*.db
**/data/*.sqlite
