# --- Python ---
__pycache__/
*.py[cod]
*.so

# --- Virtualenv ---
venv/
.venv/
.env

# --- Editor / OS ---
.vscode/
.idea/
.DS_Store
*.code-workspace

# --- Runtime output ---
logs/

# --- Local git hooks (developer convenience; not published) ---
# The hook installer clones hook bodies into scripts/git-hooks/ and symlinks
# pre-commit / pre-push / post-checkout there. None of it is published: the
# symlinks would dangle on a fresh clone, and `core.hooksPath` is local git
# config that is not cloned either, so they could never run there anyway.
#
# Machine-specific ignores go in the local, unpublished .git/info/exclude — not
# here — because this file is published. That is where the installer's version
# stamp lives (it embeds a commit hash from another repository).
scripts/git-hooks/
repo_owners.yaml

# --- Seeded SQLite database ---
# The generated database is deliberately NOT committed. `scripts/quick-start.sh`
# creates and seeds it when it is absent, so a clone proves the pipeline actually
# runs (init_db → seed_from_json) rather than trusting a committed binary, and
# diffs stay readable. `sample_data.json` — the real source of truth — IS
# committed. Matched at any depth: the artifact lives at
# pricing-scraper/data/market_data.db.
**/data/*.db
**/data/*.sqlite
